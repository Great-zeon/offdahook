# ========================================================================
# OFF DA HOOK SALON SUITES - ENVIRONMENT VARIABLES (STAGING & PRODUCTION)
# ========================================================================

# Canonical Storefront URL (Prevents open-redirect spoofing on checkout)
STOREFRONT_URL=https://offdahook.vercel.app

# Stripe API Keys (Dashboard -> Developers -> API keys; use test keys in staging!)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Supabase PostgreSQL (Use isolated staging project before production)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Resend Email Provider (Verify domain SPF/DKIM in Resend Dashboard)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_WEBHOOK_SECRET=whsec_your_resend_svix_signing_secret_here
MERCHANT_ALERT_EMAIL=offdahooksalon@gmail.com

# Administrative Authentication & Cron Protection
ADMIN_PIN=replace_with_strong_random_admin_pin
CRON_SECRET=replace_with_strong_random_cron_secret
